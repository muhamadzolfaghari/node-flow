{
  "name": "node-flow",
  "version": "1.3.2",
  "description": "NodeFlow \u2014 Free universal visual diagramming and architecture studio supporting Mermaid, XMind, Draw.io, PlantUML, Graphviz, D2, SQL DDL, and Markdown.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "test": "node test-diagrams.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "lint": "eslint .",
    "audit:templates": "node scripts/audit-templates.mjs",
    "audit:studio": "node scripts/audit-studio-tools.mjs",
    "build:app": "vite build",
    "audit:canvas": "node scripts/audit-canvas-flows.mjs",
    "audit:framing": "node scripts/audit-canvas-framing.mjs",
    "audit:quality": "node scripts/audit-code-quality.mjs",
    "audit:version": "node scripts/release-version.mjs",
    "preflight": "npm run lint && npm run test:unit && npm test && npm run audit:version",
    "pre-push": "npm run preflight",
    "release": "node scripts/release-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhamadzolfaghari/node-flow.git"
  },
  "author": "Mohammad Zolfaghari",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@google/genai": "^2.30.0",
    "@lezer/highlight": "^1.2.5",
    "@mlc-ai/web-llm": "^0.2.86",
    "@viz-js/viz": "^3.31.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "mermaid": "^11.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "lucide-react": "^1.58.0",
    "puppeteer": "25.12.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
